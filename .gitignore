# ---- 파이썬 가상환경 ----
# 수만 개 파일이라 저장소에 넣으면 안 된다. requirements.txt로 재현한다.
venv/
.venv/
env/

# ---- 파이썬 캐시/빌드 산출물 ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- 에디터/OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- HTTrack 원본 소스 (직접 빌드할 때만 필요) ----
# 앱은 미리 빌드된 engine/httrack/httrack.exe 를 쓴다. 이 폴더는 HTTrack 프로젝트의
# 별도 git 저장소라서 그대로 커밋하면 빈 폴더만 기록된다. 필요하면 아래에서 받는다.
#   https://github.com/xroche/httrack
engine/httrack_build/

# ---- 실행 중 생기는 것 ----
# 다운로드 결과물이나 로그가 저장소에 섞이지 않게 한다.
downloads/
*.log
session_cookies.txt
